# Fournisseur LLM : openai | mistral | ollama
# Mettre LLM_PROVIDER=ollama pour que le diagnostic métier appelle Ollama en local
# (Ollama doit être lancé ; port par défaut 11434).
LLM_PROVIDER=openai

# OpenAI (si LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Mistral (si LLM_PROVIDER=mistral)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Ollama (si LLM_PROVIDER=ollama)
# Utilisé aussi par la page « Assistant IA local » (chat Streamlit), toujours en local.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Comptes démo Streamlit (os.getenv dans src/demo_auth.py — repli si vide)
# Copier ce fichier en .env. Ne pas réutiliser ces secrets en production.
CLIENT_EMAIL=client@demo.fr
CLIENT_PASSWORD=Client_demo_2026!
ADMIN_EMAIL=admin@demo.fr
ADMIN_PASSWORD=Admin_demo_2026!
